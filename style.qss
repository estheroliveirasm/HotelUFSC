QMainWindow, QDialog {
    background-color: #FFF3C4;
}

QWidget {
    font-family: "Segoe UI";
    font-size: 13px;
    color: #4A3B00;
}

QMainWindow#JanelaInicial {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #FFC107,
        stop: 1 #B8860B
    );
}

QFrame#cartaoBemVindoFrame {
    background-color: #FFFDF5;
    border-radius: 16px;
    border: 1px solid #FFE9B3;
}

QFrame#linhaDivisoriaFrame {
    background-color: #FFC107;
    border-radius: 2px;
}

QLabel#monogramaLabel {
    background-color: #FFC107;
    border: 3px solid #B8860B;
    border-radius: 32px; 
    color: #402E00;
    font-size: 26px;
    font-weight: bold;
}

QLabel#hotelNomeLabel {
    font-size: 32px;
    font-weight: bold;
    color: #B8860B;
}

QLabel#hotelSloganLabel {
    font-size: 13px;
    color: #7A5C00;
}

QFrame#dashboardHeaderFrame {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #FFC107,
        stop: 1 #FFE082
    );
    border-radius: 14px;
    padding: 18px 20px;
}

QLabel#dashboardTituloLabel {
    font-size: 23px;
    font-weight: bold;
    color: #402E00;
    background: transparent;
}

QFrame#cadastroBannerFrame, QFrame#detalhesBannerFrame, QFrame#sobreBannerFrame, QFrame#reservasBannerFrame {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #B8860B,
        stop: 1 #FFC107
    );
}

QLabel#cadastroTituloLabel, QLabel#detalhesTituloLabel, QLabel#sobreTituloLabel, QLabel#reservasTituloLabel {
    font-size: 18px;
    font-weight: bold;
    color: #FFF8DC;
    background: transparent;
}

QLabel#reservasAtivasLabel {
    font-size: 15px;
    font-weight: bold;
    color: #7A5C00;
    padding-top: 4px;
}

QLabel#totalLabel {
    font-size: 17px;
    font-weight: bold;
    color: #FFFFFF;
    background-color: #E6A800;
    border-radius: 8px;
    padding: 8px;
    margin-top: 6px;
}

QPushButton {
    background-color: #FFC107;
    color: #402E00;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #FFD54F;
}

QPushButton:pressed {
    background-color: #E6A800;
}

QPushButton:disabled {
    background-color: #EFE3B5;
    color: #A89968;
}

QPushButton#entrarSistemaButton {
    background-color: #402E00;
    color: #FFD54F;
    font-size: 14px;
    border-radius: 23px;
}

QPushButton#entrarSistemaButton:hover {
    background-color: #5A4200;
}

QPushButton#fazerCheckInButton, QPushButton#confirmarButton {
    background-color: #6FA83C;
    color: #FFFFFF;
}

QPushButton#fazerCheckInButton:hover, QPushButton#confirmarButton:hover {
    background-color: #7FBB49;
}

QPushButton#fazerCheckOutButton, QPushButton#cancelarButton {
    background-color: #D9534F;
    color: #FFFFFF;
}

QPushButton#fazerCheckOutButton:hover, QPushButton#cancelarButton:hover {
    background-color: #E56662;
}

QPushButton#verDetalhesButton {
    background-color: #4F82D9;
    color: #FFFFFF;
}

QPushButton#verDetalhesButton:hover {
    background-color: #6293E0;
}

QPushButton#sobreDesenvolvedorButton, QPushButton#cadastrarHospedeButton {
    background-color: #4A3B00;
    color: #FFE082;
}

QPushButton#sobreDesenvolvedorButton:hover, QPushButton#cadastrarHospedeButton:hover {
    background-color: #6B5300;
}

QPushButton#fecharButton {
    background-color: #B8860B;
    color: #FFF8DC;
}

QLineEdit, QComboBox, QSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #E0C060;
    border-radius: 6px;
    padding: 6px;
    color: #4A3B00;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 2px solid #FFC107;
}

QLineEdit:disabled {
    background-color: #F5EFD8;
    color: #A89968;
}

QCheckBox {
    color: #4A3B00;
    spacing: 10px;
    padding: 3px 0px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #B8860B;
    border-radius: 4px;
    background-color: #FFFFFF;
}

QCheckBox::indicator:checked {
    background-color: #FFC107;
    border: 2px solid #7A5C00;
}

QGroupBox {
    background-color: #FFFDF5;
    border: 1px solid #F0DA90;
    border-radius: 12px;
    margin-top: 14px;
    font-weight: bold;
    font-size: 13px;
    color: #7A5C00;
    padding-top: 14px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 2px 10px;
    background-color: #FFE082;
    border-radius: 8px;
    color: #5A4200;
}

QFrame#veiculoFrame, QFrame#infoCardFrame, QFrame#detalhesCardFrame {
    background-color: #FFFDF5;
    border: 1px solid #F0DA90;
    border-radius: 12px;
}

QTableWidget {
    background-color: #FFFFFF;
    gridline-color: #F0DA90;
    selection-background-color: #FFE082;
    selection-color: #4A3B00;
    border: 1px solid #F0DA90;
    border-radius: 10px;
    alternate-background-color: #FFFBEA;
}

QHeaderView::section {
    background-color: #FFC107;
    color: #402E00;
    padding: 6px;
    border: none;
    border-right: 1px solid #E6A800;
    font-weight: bold;
}

QLabel#fotoDesenvolvedorLabel {
    background-color: #FFECB3;
    border: 4px solid #FFC107;
    border-radius: 75px; 
}

QLabel#projetoLabel {
    font-weight: bold;
    color: #7A5C00;
}

QGroupBox#hospedeAtualGroupBox {
    padding: 10px 18px;
}

QLabel#indicadorStatusLabel {
    background-color: #D9534F;
    border-radius: 7px;
}

QLabel#hospedeAtualLabel {
    font-weight: bold;
    font-size: 13px;
    color: #5A4200;
}

QTableWidget::item {
    padding: 6px;
}

QTableWidget::item:selected {
    background-color: #FFD54F;
    color: #402E00;
}
